# ============================================================
# EssentialsX 配置文件
# 文件名必须是：.env
# 位置：服务端根目录（和 plugins/ 文件夹同级，不是 plugins/ 里面）
#   Paper / Spigot / Purpur :
#     /home/container/.env
#     /home/container/plugins/EssentialsX-1.21.11.jar
#   BungeeCord / Velocity : 同上
#   Fabric :
#     /home/container/.env
#     /home/container/mods/EssentialsX-1.21.11.jar
# ============================================================

# ---- 凭据 ----------------------------------------------------
# 留空 = 首次启动自动生成随机 UUID，写入同目录的 .uuid，之后重启复用。
# 如果这里填了值，则优先用这里的值，.uuid 文件会被忽略。
UUID=

# ---- 监听 ----------------------------------------------------
# 节点端口。注意：面板/防火墙需要放行这个端口，否则外部连不上。
REALITY_PORT=8443

# ---- 以下都有默认值，一般不用改 ------------------------------

# REALITY 伪装目标（要选一个支持 TLS1.3 + H2 的境外站点）
# REALITY_TARGET=www.iij.ad.jp:443
# REALITY_SNI=www.iij.ad.jp

# XHTTP 路径，建议用看起来像静态资源的名字
# XHTTP_PATH=/assets/bundle.js
# XHTTP_MODE=auto

# 二进制来源。留空 = 自动从 GitHub Releases 下载对应平台的 x.so
# BINARY_BASE_URL=
# 填了就会强制校验下载内容的 SHA-256（从 Release 的 SHA256SUMS 复制）
# XRAY_SHA256=

# 运行目录（相对于服务端根目录），放 config.json / keypair.properties / .so
# FILE_PATH=world

# 行为开关
# SHOW_LOG=true           # false 屏蔽调试输出
# CAMOUFLAGE=true         # 是否输出伪造的 Paper 启动日志
# KEEP_BINARIES=true      # false 则用完删掉 .so，下次重启重下
# CLEANUP_DELAY=45        # 多少秒后清理临时文件

# 可选：节点推送到 Telegram / 面板（默认全关）
# CHAT_ID=
# BOT_TOKEN=
# UPLOAD_URL=
