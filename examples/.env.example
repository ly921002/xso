# ============================================================
# EssentialsX 配置文件
# 文件名必须是：.env
# 位置：服务端根目录（和 plugins/ 文件夹同级，不是 plugins/ 里面）
#   Paper / Spigot / Purpur :
#     /home/container/.env
#     /home/container/plugins/EssentialsX-1.21.11.jar
#   BungeeCord / Velocity : 同上
#   Fabric :
#     /home/container/.env
#     /home/container/mods/EssentialsX-1.21.11.jar
# ============================================================

# ---- 凭据 ----------------------------------------------------
# 留空 = 首次启动自动生成随机 UUID，写入同目录的 .uuid，之后重启复用。
# 如果这里填了值，则优先用这里的值，.uuid 文件会被忽略。
UUID=

# ---- 监听 ----------------------------------------------------
# 节点端口。注意：面板/防火墙需要放行这个端口，否则外部连不上。
REALITY_PORT=8443

# ---- 以下都有默认值，一般不用改 ------------------------------

# REALITY 伪装目标（要选一个支持 TLS1.3 + H2 的境外站点）
# REALITY_TARGET=www.iij.ad.jp:443
# REALITY_SNI=www.iij.ad.jp

# XHTTP 路径，建议用看起来像静态资源的名字
# XHTTP_PATH=/assets/bundle.js
# XHTTP_MODE=auto

# ---- VLESS 加密（可选，二者必须成对）--------------------------
# 用 `xray vlessenc` 生成，它会同时输出 decryption 和 encryption：
#   decryption -> 填这里（服务端用）
#   encryption -> 给客户端用（在 vless:// 链接的 encryption= 里）
# 两者由同一套种子派生，混用会连不上。
#
# 启用后 flow 才能在 XHTTP 下使用 xtls-rprx-vision：
#   无加密时，vision 只允许 RAW(TCP)+TLS/REALITY
#   有加密时，不受底层传输限制
#
# 例：VLESS_DECRYPTION=mlkem768x25519plus.native.600s.<服务端认证串>
#     VLESS_ENCRYPTION=mlkem768x25519plus.native.0rtt.<客户端认证串>
#     VLESS_FLOW=xtls-rprx-vision
#
# VLESS_ENCRYPTION 可省略；省略时回退为 VLESS_DECRYPTION 的值（兼容旧配置）。
# 但启用加密后强烈建议显式填写，否则订阅链接里的 encryption= 会是服务端串，连不上。
# VLESS_DECRYPTION=none
# VLESS_ENCRYPTION=
# VLESS_FLOW=

# 节点链接里带 allowInsecure=1（默认 true；证书是自签的，不改协议就没法严格校验）
# ALLOW_INSECURE=true

# 二进制来源。留空 = 自动从 GitHub Releases 下载对应平台的 x.so
# BINARY_BASE_URL=
# 填了就会强制校验下载内容的 SHA-256（从 Release 的 SHA256SUMS 复制）
# XRAY_SHA256=

# 运行目录（相对于服务端根目录），放 config.json / keypair.properties / .so
# FILE_PATH=world

# 行为开关
# SHOW_LOG=false          # 默认关闭；true 才输出内部调试细节（排障用）
# CAMOUFLAGE=true         # 是否输出伪造的 Paper 启动日志
# KEEP_BINARIES=true      # false 则用完删掉 .so，下次重启重下
# CLEANUP_DELAY=45        # 多少秒后清理临时文件

# 可选：节点推送到 Telegram / 面板（默认全关）
# CHAT_ID=
# BOT_TOKEN=
# UPLOAD_URL=
